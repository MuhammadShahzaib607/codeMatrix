[TEMPLATE]
# Port the HTTP + Socket.IO server listens on.
PORT=4000

# MongoDB connection string. Metadata only — project FILES are never stored here.
# Authentication REQUIRES this to be set (users and project ownership live in
# MongoDB); without it, login/register return 503.
MONGODB_URI=

# Comma-separated list of allowed browser origins, or * to allow any.
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign auth JWTs. CHANGE THIS for production — generate a strong
# random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# A weak/known secret lets anyone forge a login token.
JWT_SECRET=replace-with-a-long-random-secret

# How long a login lasts. Accepts any jsonwebtoken duration, e.g. 7d, 12h.
JWT_EXPIRES_IN=7d

# Optional override for where workspace folders live on disk.
# Defaults to <server>/workspaces
# WORKSPACES_ROOT=
