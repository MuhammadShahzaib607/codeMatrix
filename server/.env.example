# Port the HTTP + Socket.IO server listens on.
PORT=4000

# MongoDB connection string. Metadata only — project FILES are never stored here.
# Leave empty to boot without a database (the editor still works, but project
# metadata and the lastAccessedAt timestamp are not persisted).
MONGODB_URI=

# Comma-separated list of allowed browser origins, or * to allow any.
CLIENT_ORIGIN=http://localhost:5173

# Owner id attached to projects until real authentication exists.
DEFAULT_OWNER_ID=local-user

# Optional override for where workspace folders live on disk.
# Defaults to <server>/workspaces
# WORKSPACES_ROOT=
